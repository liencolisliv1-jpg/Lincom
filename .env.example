# Clé publique FedaPay (Bénin Mobile Money, Celtiis, Moov, MTN, Carte)
VITE_FEDAPAY_PUBLIC_KEY=

# Clé secrète FedaPay (Server-side API Key)
FEDAPAY_SECRET_KEY=

# Clé publique Kkiapay (Bénin Mobile Money & Carte)
VITE_KKIAPAY_PUBLIC_KEY=

# Clé privée / secrète Kkiapay (Server-side)
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET=

# Google Maps Platform API Key (Routes API, Geocoding, Places)
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Configuration Service Email SMTP (Validation & Récupération LIENCOLIS)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
